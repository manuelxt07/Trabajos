<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="450.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label text="Menú Principal">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" maxWidth="300.0" spacing="12.0">
            <children>
                <Button maxWidth="Infinity" prefHeight="40.0" text="Gestión de Clientes" onAction="#abrirGestionClientes" />
                <Button maxWidth="Infinity" prefHeight="40.0" text="Gestión de Mecánicos" onAction="#abrirGestionMecanicos" />
                <Button maxWidth="Infinity" prefHeight="40.0" text="Inventario de Repuestos" onAction="#abrirInventario" />
                <Button maxWidth="Infinity" prefHeight="40.0" text="Órdenes de Servicio" onAction="#abrirGestionOrdenes" />
                <Button maxWidth="Infinity" prefHeight="40.0" text="Bicicletas Registradas" onAction="#abrirGestionBicicletas">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</VBox>